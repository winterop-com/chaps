"""{{ name }}: a chapkit model service."""

# main.py is the model service. The parts to change are:
#   1. {{ class_name }}Config: the options of the model.
#   2. on_train and on_predict: the model itself.
#   3. info: the name, the author and the description of the model.

import os
from pathlib import Path
from typing import Any

import structlog
from geojson_pydantic import FeatureCollection

from chapkit import BaseConfig
from chapkit.api import AssessedStatus, MLServiceBuilder, MLServiceInfo, ModelMetadata, PeriodType
from chapkit.artifact import ArtifactHierarchy
from chapkit.data import DataFrame
{% if with_validation %}
from chapkit.ml import FunctionalModelRunner, ValidationDiagnostic
{% else %}
from chapkit.ml import FunctionalModelRunner
{% endif %}

log = structlog.get_logger()


class {{ class_name }}Config(BaseConfig):
    """Options of {{ name }}."""

    # The forecast horizon if the request gives none. chapkit sets it from
    # the request, so the value the model reads is the one for that request.
    prediction_periods: int = 3

    # The number of last periods the example model takes the mean of.
    window: int = 3


async def on_train(
    config: {{ class_name }}Config,
    data: DataFrame,
    geo: FeatureCollection | None = None,
) -> Any:
    """Train the model: the mean of the last `window` periods of each location."""
    df = data.to_pandas().sort_values("time_period")
    df = df.dropna(subset=["disease_cases"])
    window = max(config.window, 1)
    means = df.groupby("location")["disease_cases"].apply(lambda cases: cases.tail(window).mean())
    log.info("model_trained", locations=len(means), window=window)
    return {"means": means.to_dict()}


async def on_predict(
    config: {{ class_name }}Config,
    model: Any,
    historic: DataFrame,
    future: DataFrame,
    geo: FeatureCollection | None = None,
) -> DataFrame:
    """Predict: each future period of a location gets the mean from training."""
    future_df = future.to_pandas()
    means = model.get("means", {})
    future_df["sample_0"] = future_df["location"].map(means).fillna(0.0)
    log.info("predictions_made", rows=len(future_df))
    return DataFrame.from_pandas(future_df)


{% if with_validation %}
# The $validate hooks answer POST /api/v1/ml/$validate. They check a train or
# predict request without a job, and return a list of diagnostics. An empty
# list means that the request is correct. chapkit already checks the
# configuration, the horizon and empty data; add only the checks of the model.


async def on_validate_train(
    config: {{ class_name }}Config,
    data: DataFrame,
    geo: FeatureCollection | None = None,
) -> list[ValidationDiagnostic]:
    """Return the problems of a train request."""
    diagnostics: list[ValidationDiagnostic] = []
    if config.window < 1:
        diagnostics.append(
            ValidationDiagnostic.error(
                code="window_too_small",
                message=f"window is {config.window}; it must be 1 or more",
                field="config.window",
            )
        )
    return diagnostics


async def on_validate_predict(
    config: {{ class_name }}Config,
    historic: DataFrame,
    future: DataFrame,
    geo: FeatureCollection | None = None,
) -> list[ValidationDiagnostic]:
    """Return the problems of a predict request."""
    return []


{% endif %}
info = MLServiceInfo(
    id="{{ service_id }}",
    display_name="{{ name }}",
    version="0.1.0",
    description="Predicts the mean of the last periods of each location.",
    model_metadata=ModelMetadata(
        author="Your Name",
        # The maturity that the Modeling App shows: green (validated), yellow
        # (ready for testing), orange (promising), red (experimental), gray
        # (deprecated).
        author_assessed_status=AssessedStatus.red,
        contact_email="your.email@example.com",
    ),
    period_type=PeriodType.monthly,
    min_prediction_periods=0,
    max_prediction_periods=100,
)

HIERARCHY = ArtifactHierarchy(
    name="{{ slug }}",
    level_labels={0: "ml_training_workspace", 1: "ml_prediction"},
)

runner: FunctionalModelRunner[{{ class_name }}Config] = FunctionalModelRunner(
    on_train=on_train,
    on_predict=on_predict,
{% if with_validation %}
    on_validate_train=on_validate_train,
    on_validate_predict=on_validate_predict,
{% endif %}
)

# The service keeps its database in data/. In the image, data/ is a volume.
DATABASE_URL = os.getenv("DATABASE_URL", "sqlite+aiosqlite:///data/chapkit.db")
if DATABASE_URL.startswith("sqlite") and ":///" in DATABASE_URL:
    Path(DATABASE_URL.split("///")[1]).parent.mkdir(parents=True, exist_ok=True)

app = (
    MLServiceBuilder(
        info=info,
        config_schema={{ class_name }}Config,
        hierarchy=HIERARCHY,
        runner=runner,
        database_url=DATABASE_URL,
    )
    .with_monitoring()
    # Registers with chap-core when SERVICEKIT_ORCHESTRATOR_URL is set.
    .with_registration()
    .build()
)


if __name__ == "__main__":
    from chapkit.api import run_app

    run_app("main:app", reload=False, port=int(os.getenv("PORT", "9090")))

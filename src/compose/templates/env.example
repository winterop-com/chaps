# Generated by chap init (@CLI_VERSION@). docker compose reads this file automatically,
# so every value below applies to compose.yml and to the model overlays.

# PostgreSQL (docker compose). The password is generated once, at init time.
POSTGRES_USER=@POSTGRES_USER@
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
POSTGRES_DB=@POSTGRES_DB@

# Image tag for the chap-core services. Set a release tag (e.g. v1.2.3) to pin a version.
@CHAP_IMAGE_TAG_LINE@

# API authentication (optional). Unset means no authentication.
# Generate with `openssl rand -hex 32`; use at least 32 characters.
# CHAP_API_TOKEN=

# Shared secret for chapkit service registration (optional, separate from CHAP_API_TOKEN).
# Set it here and chap-core will require it from every model service that registers.
# SERVICEKIT_REGISTRATION_KEY=

# Overrides the URL composed from POSTGRES_*. Needed for a non-URL-safe password.
# CHAP_DATABASE_URL=

# Per-model image pins. Each overlay defaults to the pin recorded in .chaps/models.yaml;
# uncomment a line here to run a different build of that model.
@MODEL_TAG_PINS@

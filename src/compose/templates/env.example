# Written once by chaps init; chaps never rewrites it. See the docs for each setting.

# PostgreSQL credentials, generated once.
POSTGRES_USER=@POSTGRES_USER@
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
POSTGRES_DB=@POSTGRES_DB@

# Image tag for the chap-core services.
@CHAP_IMAGE_TAG_LINE@

# Host port chap-core's API is published on.
CHAP_API_PORT=@API_PORT@

# API authentication. Commented out means none.
@CHAP_API_TOKEN_LINE@

# Shared secret for chapkit service registration.
@REGISTRATION_KEY_LINE@

# Overrides the URL composed from POSTGRES_*.
# CHAP_DATABASE_URL=

# Per-model image pins.
@MODEL_TAG_PINS@

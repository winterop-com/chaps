# Generated by chap init (@CLI_VERSION@). docker compose reads this file automatically,
# so every value below applies to compose.yml and to the model overlays.

# PostgreSQL (docker compose). The password is generated once, at init time.
POSTGRES_USER=@POSTGRES_USER@
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
POSTGRES_DB=@POSTGRES_DB@

# Image tag for the chap-core services. Set a release tag (e.g. v1.2.3) to pin a version.
@CHAP_IMAGE_TAG_LINE@

# Host port chap-core's API is published on. It is the only port the stack publishes by
# default; model services are reached through it (/v2/services/<id>/run/) unless
# `chaps models expose <id>` gives one its own port.
CHAP_API_PORT=@API_PORT@

# API authentication. Commented out means no authentication at all: anyone who can reach
# the port can use the API. `chaps init --api-token` and `chaps auth enable` fill both
# lines in; `chaps auth show --reveal` prints the token to paste into the DHIS2 Modeling
# App. By hand: `openssl rand -hex 32`, at least 32 characters.
@CHAP_API_TOKEN_LINE@

# Shared secret for chapkit service registration, separate from CHAP_API_TOKEN. Every
# model overlay reads it from this file, so chap-core and the models cannot disagree.
@REGISTRATION_KEY_LINE@

# Overrides the URL composed from POSTGRES_*. Needed for a non-URL-safe password.
# CHAP_DATABASE_URL=

# Per-model image pins. Each overlay defaults to the pin recorded in .chaps/models.yaml;
# uncomment a line here to run a different build of that model.
@MODEL_TAG_PINS@
